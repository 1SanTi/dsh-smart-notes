{
  "name": "dsh-smart-notes",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Smart Notes (智能便签) for DSH: build a todo from one natural sentence — time, place and repeat are parsed automatically. Includes a calendar + wheel time picker with start/end ranges and repeat rules, plus a sidebar pending badge.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1SanTi/dsh-smart-notes.git"
  },
  "homepage": "https://github.com/1SanTi/dsh-smart-notes#readme",
  "bugs": {
    "url": "https://github.com/1SanTi/dsh-smart-notes/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
